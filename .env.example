# Copy to .env and enter credentials locally. server.py loads this file.
NVIDIA_API_KEY=
SERPER_API_KEY=
EKLIST_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
EKLIST_API_BASE=https://integrate.api.nvidia.com/v1
PORT=4174

# Optional local private contact file. Never commit this file.
EKLIST_PRIVATE_CONTACTS_PATH=

# Render hosted mode (see docs/DEPLOYMENT.md; leave unset locally)
# EKLIST_HOSTED=1
# EKLIST_BACKEND_TOKEN=
# EKLIST_CATALOG_SEED_URL=
# EKLIST_CATALOG_SEED_SHA256=

# Vercel only; never expose these as public frontend variables
# EKLIST_BACKEND_URL=
# EKLIST_BACKEND_TOKEN=
# EKLIST_DEMO_USER=
# EKLIST_DEMO_PASSWORD=
